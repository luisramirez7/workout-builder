{
  "name": "workout-builder-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/exporters/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run -ws build",
    "typecheck": "npm run -ws typecheck",
    "test": "npm run -ws test",
    "dev:web": "npm run -w @workout-builder/web start",
    "dev:mobile": "npm run -w @workout-builder/mobile start"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "typescript": "^5.6.3"
  }
}
